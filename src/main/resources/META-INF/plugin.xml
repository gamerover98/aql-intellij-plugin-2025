<idea-plugin>
    <depends>com.intellij.modules.lang</depends>
    <depends optional="true" config-file="aql-language.xml">org.intellij.intelliLang</depends>
    <depends>com.intellij.modules.java</depends>

    <resource-bundle>messages.ArangoBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.arangodb.intellij.aql.startup.ArangoProjectActivity"/>

        <!-- A tool window provide custom dockable panels in the IDE, allowing users to
             interact with plugin features such as database management, consoles, or
             custom UIs directly within the IntelliJ interface. -->
        <!-- TODO: Add/Edit here the reworked tool window for ArangoDB management and console -->
        <toolWindow id="ArangoToolWindow"
                    anchor="right"
                    secondary="false"
                    factoryClass="com.arangodb.intellij.aql.toolWindow.ServerToolWindowFactory"
                    icon="/icons/toolbarArangoDB.png"/>

        <toolWindow id="ArangoDB Console"
                    anchor="bottom"
                    secondary="false"
                    factoryClass="com.arangodb.intellij.aql.ui.ConsoleWindowFactory"
                    icon="/icons/toolbarArangoDB.png"/>

        <!--
          //############################################
          // Language setup
          //############################################
        -->
        <codeInsight.parameterNameHints language="AQL"
                                        implementationClass="com.arangodb.intellij.aql.editor.AqlParameterNameHints"/>
        <codeInsight.parameterInfo language="AQL"
                                   implementationClass="com.arangodb.intellij.aql.editor.AqlParameterInfoHandler"/>
        <fileType name="AQL file"
                  implementationClass="com.arangodb.intellij.aql.fileTypes.AqlFileType"
                  fieldName="INSTANCE"
                  language="AQL"
                  extensions="aql"/>

      <defaultLiveTemplatesProvider implementation="com.arangodb.intellij.aql.templates.AqlTemplateProvider" />
      <liveTemplateContext implementation="com.arangodb.intellij.aql.templates.AqlTemplateContext"/>

        <!-- Parser definition: https://plugins.jetbrains.com/docs/intellij/lexer-and-parser-definition.html#register-the-parser-definition -->
        <lang.parserDefinition
                language="AQL"
                implementationClass="com.arangodb.intellij.aql.lang.AqlParserDefinition"/>

        <!-- File templates: https://plugins.jetbrains.com/docs/intellij/using-file-templates.html#custom-create-file-from-template-actions -->
        <internalFileTemplate name="AQL Template.aql"/> <!-- Simple empty AQL template file -->
        <!-- TODO: Add spring-data-aql template file -->

      <colorSettingsPage implementation="com.arangodb.intellij.aql.settings.AqlColorSettingsPage"/>
      <additionalTextAttributes scheme="Default" file="colors/AQLDefault.xml"/>
      <additionalTextAttributes scheme="Darcula" file="colors/AQLDarcula.xml"/>

        <!-- PSI References: https://plugins.jetbrains.com/docs/intellij/psi-references.html#contributed-references -->
        <!-- NOTE: Please ignore the IDE warning because we want to use the reference contributor in all files. -->
        <psi.referenceContributor implementation="com.arangodb.intellij.aql.lang.AqlPsiReferenceContributor"/>

        <!-- Go to Symbol: https://www.jetbrains.com/help/rider/Navigation_and_Search__Go_to_Symbol.html -->
        <gotoSymbolContributor implementation="com.arangodb.intellij.aql.lang.AqlChooseByNameContributor"/>

        <!-- Structure View: https://plugins.jetbrains.com/docs/intellij/structure-view.html -->
        <lang.psiStructureViewFactory
                language="AQL"
                implementationClass="com.arangodb.intellij.aql.lang.AqlPsiStructureViewFactory"/>

      <lang.findUsagesProvider language="AQL" implementationClass="com.arangodb.intellij.aql.lang.AqlFindUsagesProvider"/>
      <platform.backend.documentation.psiTargetProvider implementationClass="com.arangodb.intellij.aql.lang.AqlDocumentationTargetProvider"/>
      <gotoDeclarationHandler implementation="com.arangodb.intellij.aql.lang.AqlCollectionGotoDeclarationHandler"/>

        <!-- Syntax Highlighter:
             https://plugins.jetbrains.com/docs/intellij/syntax-highlighter-and-color-settings-page.html#register-the-syntax-highlighter-factory -->
        <lang.syntaxHighlighterFactory
                language="AQL"
                implementationClass="com.arangodb.intellij.aql.syntax.AqlSyntaxHighlighterFactory"/>

        <!-- Refers to the mechanism used to create Language-Specific
             PSI elements from an Abstract Syntax Tree (AST) -->
        <lang.ast.factory
                language="AQL"
                implementationClass="com.arangodb.intellij.aql.lang.psi.AqlASTFactory"/>
      <!--
      <codeStyleSettingsProvider implementation="com.simpleplugin.SimpleCodeStyleSettingsProvider"/>
      <langCodeStyleSettingsProvider implementation="com.simpleplugin.SimpleLanguageCodeStyleSettingsProvider"/>
      -->

        <!-- Code Style Settings Provider:
             https://plugins.jetbrains.com/docs/intellij/code-style-settings.html#register-the-code-style-settings-provider -->
        <codeStyleSettingsProvider implementation="com.arangodb.intellij.aql.syntax.AqlCodeStyleSettingsProvider"/>

        <!-- Language Code Style Settings Provider:
             https://plugins.jetbrains.com/docs/intellij/code-style-settings.html#define-the-language-code-style-settings-provider -->
        <langCodeStyleSettingsProvider
                implementation="com.arangodb.intellij.aql.syntax.AqlLanguageCodeStyleSettingsProvider"/>

        <!-- Annotator: https://plugins.jetbrains.com/docs/intellij/annotator.html -->
        <annotator language="AQL"
                   implementationClass="com.arangodb.intellij.aql.syntax.AqlSyntaxHighlighterAnnotator"/>

        <!-- Commenter: https://plugins.jetbrains.com/docs/intellij/commenter.html -->
        <lang.commenter
                language="AQL"
                implementationClass="com.arangodb.intellij.aql.syntax.AqlCommenter"/>

      <completion.contributor language="AQL" implementationClass="com.arangodb.intellij.aql.editor.AqlCodeCompletionContributor"/>

      <localInspection language="AQL"
                       shortName="AqlUndefinedCollection"
                       displayName="Unknown ArangoDB collection, graph, or view"
                       groupName="AQL"
                       enabledByDefault="true"
                       level="WEAK WARNING"
                       implementationClass="com.arangodb.intellij.aql.inspections.AqlUndefinedCollectionInspection"/>

      <!--
        //############################################
        // Services
        //############################################
      -->
      <projectService serviceInterface="com.arangodb.intellij.aql.db.AqlDatabaseService"
                      serviceImplementation="com.arangodb.intellij.aql.db.AqlDatabaseServiceImpl"/>
      <projectService serviceImplementation="com.arangodb.intellij.aql.ui.DataWindowState"/>
      <projectService serviceImplementation="com.arangodb.intellij.aql.services.AqlConsoleStateService"/>

        <intentionAction>
            <language>AQL</language>
            <className>com.arangodb.intellij.aql.intentions.AqlCreateConnectionIntention</className>
        </intentionAction>

        <!-- Temporarily disabled because the AqlCreateRepositoryIntention must be re-implemented -->
        <!--<intentionAction>
          <category>AQL</category>-->
            <!--<bundleName>com.arangodb.intellij.aql.intentions.AqlIntentionsBundle</bundleName>
            <categoryKey>intention.aql.create.repository</categoryKey>-->
        <!--<className>com.arangodb.intellij.aql.intentions.AqlCreateRepositoryIntention</className>
      </intentionAction>-->
    </extensions>

    <actions>
        <action id="com.arangodb.intellij.aql.actions.AqlExecuteQueryAction"
                class="com.arangodb.intellij.aql.actions.AqlExecuteQueryAction" text="Execute AQL Query"
                icon="/icons/run.svg" description="Execute AQL Query">
            <add-to-group group-id="EditorPopupMenu.Run" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl ENTER"/>
        </action>
        <action id="com.arangodb.intellij.aql.actions.AqlExplainQueryAction"
                class="com.arangodb.intellij.aql.actions.AqlExplainQueryAction" text="Explain AQL Query"
                icon="/icons/explain.svg" description="Explain AQL Query">
            <add-to-group group-id="EditorPopupMenu.Run" anchor="first"/>
        </action>

        <action id="aql.NewAqlFile"
                class="com.arangodb.intellij.aql.file.AqlFileTemplateAction">
            <add-to-group group-id="NewGroup"
                          anchor="before"
                          relative-to-action="NewFile"/>
        </action>

        <group id="AQL.Action.Console" text="AQL Console">
            <action id="AQL.Action.Console.ExecuteQuery"
                    class="com.arangodb.intellij.aql.actions.AqlExecuteQueryAction"
                    text="Execute AQL query"
                    icon="/icons/run.svg"
                    description="Execute AQL query">
            </action>
            <action id="AQL.Action.Console.Export"
                    class="com.arangodb.intellij.aql.actions.AqlExportResultsAction"
                    text="Export Results to File"
                    icon="/icons/query.svg"
                    description="Save query results to a JSON file">
            </action>
            <action id="AQL.Action.Console.Clean"
                    class="com.arangodb.intellij.aql.actions.AqlEmptyLogAction"
                    text="Clear Query Console"
                    icon="/icons/trash.svg"
                    description="Clear">
            </action>
        </group>
    </actions>

</idea-plugin>

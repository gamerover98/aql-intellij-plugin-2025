<?xml version="1.0" encoding="UTF-8"?>
<component name="LanguageInjectionConfiguration">
  <!--
    Injects AQL language into the value() attribute of Spring Data ArangoDB's @Query annotation.
    This enables AQL syntax highlighting, completion, and inspections inside @Query strings:
      @Query("FOR c IN characters FILTER c.surname == @surname RETURN c")

    NOTE: Only @Query.value is injected here. Other Spring Data annotations such as @Document,
    @Field, and index annotations (@PersistentIndex, @HashIndex, etc.) contain collection or
    field names — plain strings, NOT AQL — and are intentionally NOT injected to avoid false
    parse errors. Collection name completion for @Document is handled by
    SpringDataCompletionContributor instead.
  -->
  <injection language="AQL" injector-id="java">
    <display-name>ArangoDB AQL — @Query value</display-name>
    <place>
      <![CDATA[
      psiMethod().withName("value").withParameters().definedInClass("com.arangodb.springframework.annotation.Query")
      ]]>
    </place>
  </injection>
</component>
